{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "franklinogf/churchesadmin",
  "type": "project",
  "description": "A admin panel for managing churches",
  "keywords": [
    "members",
    "missioaries",
    "churches",
    "church",
    "church-management",
    "church-admin-dashboard",
    "admin-panel",
    "church-management"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "barryvdh/laravel-dompdf": "^3.1.2",
    "bavix/laravel-wallet": "^12.0.1",
    "codezero/laravel-unique-translation": "^4.3.1",
    "filament/filament": "^5.6.4",
    "gboquizosanchez/filament-log-viewer": "^2.3.0",
    "inertiajs/inertia-laravel": "^3.1",
    "kwn/number-to-words": "^2.12.0",
    "laravel/framework": "^13.11.2",
    "laravel/reverb": "^1.10.2",
    "laravel/tinker": "^3.0.2",
    "laravel/wayfinder": "^0.1.20",
    "mallardduck/blade-lucide-icons": "^1.26.20",
    "propaganistas/laravel-phone": "^6.0.3",
    "resend/resend-laravel": "^1.4",
    "spatie/laravel-activitylog": "^5.0",
    "spatie/laravel-medialibrary": "^11.22.1",
    "spatie/laravel-permission": "^7.4.1",
    "spatie/laravel-tags": "^4.11.0",
    "spatie/laravel-translatable": "^6.14.1",
    "stancl/tenancy": "dev-master"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.3",
    "fakerphp/faker": "^1.24.1",
    "franklinogf/laravel-utils": "^0.2.3",
    "larastan/larastan": "^3.9.6",
    "laravel/boost": "^2.4.8",
    "laravel/pail": "^1.2.6",
    "laravel/pao": "^1.0.6",
    "laravel/pint": "^1.29.1",
    "laravel/sail": "^1.60.0",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.9.4",
    "pestphp/pest": "^4.7",
    "pestphp/pest-plugin-laravel": "^4.1",
    "pestphp/pest-plugin-type-coverage": "^4.0.4",
    "rector/rector": "^2.4.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@php artisan boost:update --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "pnpx concurrently -c \"#93c5fd,#c4b5fd,#fdba74,#fdba82\" \"php artisan serve\" \"php artisan queue:listen --queue=emails,default --tries=1\" \"pnpm run dev\" \"php artisan reverb:start\" --names='server,queue,vite,reverb'"
    ],
    "dev:ssr": [
      "npm run build:ssr",
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --queue=emails,default --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr"
    ],
    "lint": "pint --parallel -vv",
    "refactor": "rector",
    "format": [
      "@refactor",
      "@lint"
    ],
    "test:refactor": "rector --dry-run",
    "test:lint": "pint --parallel --bail",
    "test:types": [
      "phpstan analyse",
      "pest --type-coverage --compact --colors=always --min=100"
    ],
    "test:unit": "pest --testsuite=Unit --stop-on-failure",
    "test:feature": "pest --testsuite=Feature --stop-on-failure",
    "test:all": "pest --parallel --coverage --compact --colors=always --profile --stop-on-failure",
    "test:cleanup": "php artisan test:cleanup",
    "test:migrate": "php artisan migrate --database=testing",
    "test": [
      "@test:refactor",
      "@test:types",
      "@test:lint",
      "@test:all"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "RC",
  "prefer-stable": true
}
